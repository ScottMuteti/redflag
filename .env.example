POSTGRES_USER=redflag
POSTGRES_PASSWORD=redflag
POSTGRES_DB=redflag

PORT=4000
# Internet-facing listener: only the click-tracking endpoint binds here.
# This is the ONLY port that should be exposed/tunnelled publicly (see
# docs/decisions/003). Keep PORT (admin API) private.
PUBLIC_PORT=4001
JWT_SECRET=change-me
DB_HOST=postgres
DB_PORT=5432
DB_USER=redflag
DB_PASSWORD=redflag
DB_NAME=redflag
GOPHISH_API_URL=https://gophish:3333
GOPHISH_API_KEY=
GOPHISH_WEBHOOK_SECRET=
GOPHISH_SMTP_PROFILE=RedFlag SMTP
GOPHISH_LANDING_PAGE=RedFlag Awareness Landing
GOPHISH_PHISH_URL=http://localhost:8080
GOPHISH_WEBHOOK_URL=http://simulation-engine:4000/api/campaigns/webhook/gophish

# Dedicated throwaway Gmail, 2-Step Verification on, 16-char App Password
# (not the normal login password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

AT_API_KEY=
AT_USERNAME=sandbox
# Template assistant (regenerate/refine) runs locally; no API key needed.
ML_SERVICE_URL=http://risk-model:8000
ML_TIMEOUT_MS=5000
# Base of SMS tracking links. Africa's Talking blocks localhost links; locally use
# http://lvh.me:4001 (resolves to 127.0.0.1), else a public tunnel.
PUBLIC_BACKEND_URL=http://lvh.me:4001

# Phishing reporting. REPORT_INBOX and REPORT_SMS_NUMBER are shown to staff as
# the forward-to address and report-by-text number. REPORT_INBOUND_SECRET gates
# POST /api/reports/inbound (email and SMS); a mail forwarder or SMS provider
# sends it in the x-report-secret header. Blank disables the inbound webhook.
REPORT_INBOX=
REPORT_SMS_NUMBER=
REPORT_INBOUND_SECRET=

# Google sign-in: OAuth web client ID (Google Cloud > Credentials), with
# http://localhost:5173 as an authorised JavaScript origin. Blank hides the button.
GOOGLE_CLIENT_ID=
# Passkeys: the portal's host and exact origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Portal address used in password-reset and invite links.
PORTAL_URL=http://localhost:5173
# Host port for the portal (keep PORTAL_URL and WEBAUTHN_ORIGIN in step).
PORTAL_PORT=5173

POSTGRES_USER=redflag
POSTGRES_PASSWORD=redflag
POSTGRES_DB=redflag

PORT=4000
# Internet-facing listener: only the click-tracking endpoint binds here.
# This is the ONLY port that should be exposed/tunnelled publicly (see
# docs/decisions/003). Keep PORT (admin API) private.
PUBLIC_PORT=4001
JWT_SECRET=change-me
DB_HOST=postgres
DB_PORT=5432
DB_USER=redflag
DB_PASSWORD=redflag
DB_NAME=redflag
GOPHISH_API_URL=https://gophish:3333
GOPHISH_API_KEY=
GOPHISH_WEBHOOK_SECRET=
GOPHISH_SMTP_PROFILE=RedFlag SMTP
GOPHISH_LANDING_PAGE=RedFlag Awareness Landing
GOPHISH_PHISH_URL=http://localhost:8080
GOPHISH_WEBHOOK_URL=http://simulation-engine:4000/api/campaigns/webhook/gophish

# Dedicated throwaway Gmail, 2-Step Verification on, 16-char App Password
# (not the normal login password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

AT_API_KEY=
AT_USERNAME=sandbox
ML_SERVICE_URL=http://risk-model:8000
ML_TIMEOUT_MS=5000
PUBLIC_BACKEND_URL=http://localhost:4000

# Google sign-in: OAuth web client ID (Google Cloud > Credentials), with
# http://localhost:5173 as an authorised JavaScript origin. Blank hides the button.
GOOGLE_CLIENT_ID=
# Passkeys: the portal's host and exact origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Portal address used in password-reset and invite links.
PORTAL_URL=http://localhost:5173

PORT=4000
# Use a long random value in any shared/deployed environment; the engine refuses
# to start in production with this placeholder.
JWT_SECRET=change-me
DB_HOST=localhost
DB_PORT=5432
DB_USER=redflag
DB_PASSWORD=redflag
DB_NAME=redflag

# Gophish admin API (self-signed cert is expected on the internal endpoint).
GOPHISH_API_URL=https://localhost:3333
GOPHISH_API_KEY=
# Shared secret; must match the webhook created by `npm run gophish:setup`.
GOPHISH_WEBHOOK_SECRET=
GOPHISH_SMTP_PROFILE=RedFlag SMTP
GOPHISH_LANDING_PAGE=RedFlag Awareness Landing
# Where tracking links point (the Gophish phishing listener), reachable from
# the clicker's browser.
GOPHISH_PHISH_URL=http://localhost:8080
# Where Gophish posts events back to this engine (defaults to the compose host).
GOPHISH_WEBHOOK_URL=http://simulation-engine:4000/api/campaigns/webhook/gophish

# Gmail account that Gophish relays simulated emails through. Use a dedicated
# throwaway account with 2-Step Verification on, and a 16-char App Password
# (NOT the normal login password — SMTP auth rejects it).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Africa's Talking sandbox (SMS). Sandbox has no custom sender ID.
AT_API_KEY=
AT_USERNAME=sandbox

ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=5000
# Base URL embedded in SMS tracking links, reachable from the recipient.
PUBLIC_BACKEND_URL=http://localhost:4000
